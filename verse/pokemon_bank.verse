MakePokemonQuestionsFR() : []question =
    MakePokemonQuestionsFR1() + MakePokemonQuestionsFR2() + MakePokemonQuestionsFR3() + MakePokemonQuestionsFR4() + MakePokemonQuestionsFR5()

MakePokemonQuestions() : []question =
    MakePokemonQuestionsFR()

