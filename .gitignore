# ── Fichiers generes par les outils tools/ (regenerables, ou qu'ils soient) ──
tools/**/layout.json
tools/**/placement_manifest.json
tools/**/quiz_map.obj
tools/**/quiz_map.mtl
tools/**/*.verse.txt

# ── Config locale MCP + serveur tiers cloné (ne pas committer) ──
.mcp.json
.mcp-server/

# ── Projet UEFN local (lourd, spécifique machine) ──
maps/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── OS / éditeurs ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── UEFN / Unreal (si le projet UEFN est ajouté plus tard) ──
Intermediate/
Saved/
DerivedDataCache/
Binaries/
Build/
*.tmp

# ── Assets générés (images / audio / 3D) — régénérables par tools/, lourds, certains sous licence tierce ──
# Tout le contenu de assets/ est ignoré SAUF son manifeste documentaire.
assets/*
!assets/README.md
*.glb
SSL_CERT_FILE_backup.txt
tools/_*
